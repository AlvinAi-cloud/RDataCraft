  "import_reports": [],
  "r_analyses": [
    {
      "id": "20261024103259.111325-46118415",
      "title": "Generalized linear model",
      "code": "# This template extends beyond the app presets.\n# Rename your input columns to Response, Treatment and Batch, or edit the formula.\nrequired <- c(\"Response\", \"Treatment\", \"Batch\")\nif (!all(required %in% names(data))) stop(\"This example needs Response, Treatment and Batch columns. Edit the formula for your data.\")\nfit <- stats::glm(Response ~ Treatment + Batch, data=data, family=stats::poisson())\nresult <- list(tables=list(Coefficients=as.data.frame(cbind(Term=rownames(summary(fit)$coefficients), summary(fit)$coefficients))),\n text=\"Poisson GLM: verify count outcomes, independence and dispersion. This template does not establish model suitability.\")",
      "packages": "stats",
      "source_name": "Count design",
      "source_tsv": "\"Response\"\t\"Treatment\"\t\"Batch\"\n\"2\"\t\"A\"\t\"X\"\n\"3\"\t\"A\"\t\"Y\"\n\"5\"\t\"A\"\t\"X\"\n\"7\"\t\"A\"\t\"Y\"\n\"4\"\t\"A\"\t\"X\"\n\"5\"\t\"A\"\t\"Y\"\n\"8\"\t\"B\"\t\"X\"\n\"9\"\t\"B\"\t\"Y\"\n\"3\"\t\"B\"\t\"X\"\n\"4\"\t\"B\"\t\"Y\"\n\"6\"\t\"B\"\t\"X\"\n\"8\"\t\"B\"\t\"Y\"",
      "created": "2026-10-24 14:32:59 UTC",
      "result": null
    },
    {
      "id": "20261024103259.217664-33403143",
      "title": "Custom summaries and intervals",
      "code": "# data is an independent copy of the selected input table.\n# Convert or reshape explicitly when the study design requires it.\nnumeric_columns <- data[vapply(data, is.numeric, logical(1))]\nif (!length(numeric_columns)) stop(\"Choose a table with numeric measurements.\")\nsummary_table <- do.call(rbind, lapply(names(numeric_columns), function(name) {\n  x <- stats::na.omit(numeric_columns[[name]])\n  data.frame(Variable=name, N=length(x), Mean=mean(x), SD=stats::sd(x))\n}))\nresult <- list(tables=list(Summary=summary_table),\n  plot=ggplot2::ggplot(summary_table, ggplot2::aes(x=Variable, y=Mean)) +\n    ggplot2::geom_point() + ggplot2::labs(title=\"Custom R summary\"),\n  text=\"Descriptive results; no inferential test was selected.\")",
      "packages": "",
      "source_name": "Independent groups",
      "source_tsv": "\"Control\"\t\"Treatment A\"\t\"Treatment B\"\n\"8.4\"\t\"12.6\"\t\"17.3\"\n\"9.7\"\t\"14.2\"\t\"19.6\"\n\"10.3\"\t\"13.1\"\t\"18.2\"\n\"8.9\"\t\"15.4\"\t\"21.1\"\n\"11.2\"\t\"14.8\"\t\"20.4\"\n\"9.5\"\t\"12.9\"\t\"18.9\"\n\"10.8\"\t\"16.1\"\t\"22.5\"\n\"9.1\"\t\"13.7\"\t\"19.8\"",
      "created": "2026-10-24 14:32:59 UTC",
      "result": null
    },
    {
      "id": "20261024103259.225094-27749177",
      "title": "Custom rank comparison",
      "code": "numeric_columns <- data[vapply(data, is.numeric, logical(1))]\nif (ncol(numeric_columns) < 2) stop(\"Choose at least two numeric columns.\")\nx <- stats::na.omit(numeric_columns[[1]])\ny <- stats::na.omit(numeric_columns[[2]])\nfit <- stats::wilcox.test(x, y, exact=FALSE, conf.int=TRUE)\nresult <- list(tables=list(Test=data.frame(Statistic=unname(fit$statistic), P=fit$p.value,\n  CI_low=fit$conf.int[1], CI_high=fit$conf.int[2])), text=paste(fit$method, \"Assumes independent experimental units.\"))",
      "packages": "stats",
      "source_name": "Independent groups",
      "source_tsv": "\"Control\"\t\"Treatment A\"\t\"Treatment B\"\n\"8.4\"\t\"12.6\"\t\"17.3\"\n\"9.7\"\t\"14.2\"\t\"19.6\"\n\"10.3\"\t\"13.1\"\t\"18.2\"\n\"8.9\"\t\"15.4\"\t\"21.1\"\n\"11.2\"\t\"14.8\"\t\"20.4\"\n\"9.5\"\t\"12.9\"\t\"18.9\"\n\"10.8\"\t\"16.1\"\t\"22.5\"\n\"9.1\"\t\"13.7\"\t\"19.8\"",
      "created": "2026-10-24 14:32:59 UTC",
      "result": null
    }
  ]
